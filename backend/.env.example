# Backend Environment Variables Example
# Copy to backend/.env for local development

ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/idea2market
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration
# Options: openai | gemini | anthropic | fake
LLM_PROVIDER=fake
LLM_API_KEY=your-api-key-here
# OpenAI Configuration (Member 2 AI Foundation)
OPENAI_API_KEY=
OPENAI_MODEL=
# Example models to verify against provider docs:
# OpenAI: gpt-4o-mini / gpt-4o
# Gemini: gemini-2.5-pro / gemini-2.5-flash
# Anthropic: claude-3-5-sonnet-20241022 / claude-3-5-haiku-20241022
LLM_MODEL_STRONG=gemini-2.5-pro
LLM_MODEL_FAST=gemini-2.5-flash
MAX_TOKENS_PER_PROJECT=25000

# Admin
ADMIN_EMAIL=admin@idea2market.local

# Logging
LOG_LEVEL=info
